---
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'
import ProfileLayout from '@/layouts/ProfileLayout.astro'
import ProfileHero from './ProfileHero.astro'
import ProjectCard from './ProjectCard.astro'
import ustcCampus from '../../assets/education/ustc-east-gate.jpg'
import uscCampus from '../../assets/education/usc-yumu-gate.jpg'
import { homePath, profile, sections, text, type Locale, type SectionId } from '../../data/profile'

interface Props { locale: Locale; section: SectionId }
const { locale, section } = Astro.props
const currentSection = sections.find((item) => item.id === section)!
const campusImages: Record<string, { image: ImageMetadata; position: string }> = {
  'education-ustc': { image: ustcCampus, position: '50% 42%' },
  'education-usc': { image: uscCampus, position: '50% 50%' }
}
const contents: Record<SectionId, Array<{ id: string; label: string }>> = {
  about: [
    { id: 'biography', label: locale === 'zh' ? '个人简介' : 'Biography' },
    { id: 'skills', label: locale === 'zh' ? '专业技能' : 'Skills' }
  ],
  education: profile.education.map((entry) => ({ id: entry.id, label: text(entry.school, locale) })),
  projects: profile.projects.map((entry) => ({ id: entry.id, label: text(entry.title, locale) })),
  internships: profile.internships.map((entry) => ({ id: entry.id, label: text(entry.organization, locale) })),
  publications: profile.publications.map((entry) => ({ id: entry.id, label: entry.title }))
}
const toc = contents[section]
const emptyMessage = section === 'internships'
  ? { zh: '实习经历待补充。', en: 'Internship details to be added.' }
  : { zh: '论文信息待补充。', en: 'Publication details to be added.' }
---

<ProfileLayout {locale} {section}>
  <main id='main-content' data-profile-page={section}>
    <a class='back-link' href={homePath(locale)}><span aria-hidden='true'>‹</span> {locale === 'zh' ? '返回首页' : 'Back to home'}</a>
    <div class='page-grid'>
      <div class='page-content'>
        <header class='page-heading'>
          <h1>{text(currentSection.label, locale)}</h1>
          <p>{text(currentSection.summary, locale)}</p>
        </header>

        {section === 'about' && <section id='biography' class='biography'>
          <ProfileHero {locale} headingLevel='h2' />
          <p class='introduction'>{text(profile.introduction, locale)}</p>
          <blockquote class='motto' lang='en'>“{profile.motto}”</blockquote>
        </section>}

        {section === 'about' && <section id='skills' class='skills-section'>
          <h2>{locale === 'zh' ? '专业技能' : 'Skills'}</h2>
          <dl class='skills-list'>
            {profile.skills.map((skill) => <div class='skill-entry'>
              <dt>{text(skill.title, locale)}</dt>
              <dd>{text(skill.description, locale)}</dd>
            </div>)}
          </dl>
        </section>}

        {section === 'education' && <>
          <div class='entry-list'>
            {profile.education.map((entry) => {
              const campus = campusImages[entry.id]
              return <article class='education-entry' id={entry.id} style={{ '--campus-position': campus?.position ?? 'center' }}>
                {campus && <div class='campus-image' aria-hidden='true'>
                  <Image src={campus.image} alt='' width={800} format='webp' quality={85} loading='eager' />
                </div>}
                <div class='education-copy'>
                  <span class='entry-date'>{text(entry.dates, locale)}</span>
                  <h2>{text(entry.school, locale)}</h2>
                  <p class='entry-subtitle'>{text(entry.qualification, locale)}</p>
                  {text(entry.description, locale) && <p class='entry-description'>{text(entry.description, locale)}</p>}
                </div>
              </article>
            })}
          </div>
          <p class='image-credits'>
            {locale === 'zh' ? '校园图片：' : 'Campus photos: '}
            <a href='https://welcome.ustc.edu.cn/' target='_blank' rel='noopener noreferrer'>{locale === 'zh' ? '中国科大' : 'USTC'}</a>
            <span aria-hidden='true'> · </span>
            <a href='https://www.usc.edu.cn/info/1028/1952.htm' target='_blank' rel='noopener noreferrer'>{locale === 'zh' ? '南华大学' : 'University of South China'}</a>
          </p>
        </>}

        {section === 'projects' && <div class='entry-list'>
          {profile.projects.map((entry, index) => <ProjectCard {locale} project={entry} {index} />)}
        </div>}

        {section === 'internships' && <div class='entry-list'>
          {profile.internships.map((entry) => <article class='timeline-entry' id={entry.id}>
            <div class='entry-heading'>
              <h2>{text(entry.organization, locale)}</h2>
              <span class='entry-date'>{text(entry.dates, locale)}</span>
            </div>
            <p class='entry-subtitle'>{text(entry.role, locale)}</p>
            <p class='entry-description'>{text(entry.description, locale)}</p>
          </article>)}
        </div>}

        {section === 'publications' && <div class='entry-list'>
          {profile.publications.map((entry) => <article class='publication-entry' id={entry.id}>
            <h2>{entry.title}</h2>
            <p class='paper-authors'>{entry.authors}</p>
            <p class='paper-venue'>{entry.venue}{entry.year && ' · ' + entry.year}</p>
            <p class='entry-description'>{text(entry.description, locale)}</p>
            {entry.links.length > 0 && <div class='resource-links'>
              {entry.links.map((link) => <a href={link.href}>{text(link.label, locale)} ↗</a>)}
            </div>}
          </article>)}
        </div>}

        {toc.length === 0 && <p class='empty-state'>{text(emptyMessage, locale)}</p>}
      </div>
      {toc.length > 0 && <aside class='page-toc'>
        <h2>{locale === 'zh' ? '本页目录' : 'On this page'}</h2>
        <nav aria-label={locale === 'zh' ? '本页目录' : 'On this page'}>
          {toc.map((item) => <a href={'#' + item.id}>{item.label}</a>)}
        </nav>
      </aside>}
    </div>
  </main>
</ProfileLayout>

<style>
  main { padding-block: 1.5rem 5rem; }
  .back-link { display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.3rem 0.65rem; border: 1px solid hsl(var(--border)); border-radius: 0.5rem; background: hsl(var(--muted) / 0.6); color: hsl(var(--muted-foreground)); font-size: 0.85rem; }
  .back-link > span { font-size: 1.25rem; line-height: 1; }
  .back-link:hover { color: hsl(var(--foreground)); background: hsl(var(--muted)); }
  .page-grid { display: grid; grid-template-columns: minmax(0, 1fr) 13rem; gap: 3rem; align-items: start; margin-top: 2rem; }
  .page-content { min-width: 0; }
  .page-heading { margin-bottom: 3rem; }
  h1 { font-size: 2rem; line-height: 1.4; font-weight: 500; letter-spacing: -0.02em; }
  .page-heading p { margin-top: 1.25rem; color: hsl(var(--muted-foreground)); line-height: 1.85; white-space: pre-line; }
  .introduction { margin-top: 2rem; color: hsl(var(--muted-foreground)); line-height: 1.9; white-space: pre-line; }
  article, .biography, .skills-section { scroll-margin-top: 7rem; }
  .motto { margin-top: 1.5rem; padding-left: 1rem; border-left: 2px solid hsl(var(--primary) / 0.4); color: hsl(var(--muted-foreground)); font-style: italic; line-height: 1.8; }
  .skills-section { margin-top: 3rem; }
  .skills-section > h2 { font-size: 1.3rem; font-weight: 600; }
  .skills-list { display: grid; margin-top: 1rem; }
  .skill-entry { padding-block: 1.25rem; border-bottom: 1px solid hsl(var(--border)); }
  .skill-entry dt { font-size: 1rem; font-weight: 600; }
  .skill-entry dd { margin-top: 0.5rem; color: hsl(var(--muted-foreground)); font-size: 0.95rem; line-height: 1.9; }
  .entry-list { display: grid; gap: 1.5rem; }
  .education-entry {
    position: relative; isolation: isolate; display: flex; align-items: center;
    min-height: 12rem; padding: 1.75rem; overflow: hidden;
    border: 1px solid hsl(var(--border)); border-radius: 1.15rem;
    background: linear-gradient(110deg, hsl(var(--background)) 30%, hsl(var(--primary) / 0.055));
    box-shadow: 0 2px 5px hsl(var(--foreground) / 0.02);
  }
  .campus-image {
    position: absolute; inset: 0 0 0 26%; z-index: -1; pointer-events: none; opacity: 0.72;
    -webkit-mask-image: linear-gradient(90deg, transparent, rgb(0 0 0 / 0.06) 24%, rgb(0 0 0 / 0.58) 58%, #000 100%);
    mask-image: linear-gradient(90deg, transparent, rgb(0 0 0 / 0.06) 24%, rgb(0 0 0 / 0.58) 58%, #000 100%);
  }
  .campus-image :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: var(--campus-position); filter: saturate(0.75); }
  .education-copy { width: 70%; }
  .education-copy .entry-date { display: block; margin-bottom: 0.75rem; font-size: 0.75rem; letter-spacing: 0.025em; }
  .education-copy h2 { line-height: 1.5; text-wrap: balance; }
  .education-copy .entry-subtitle { line-height: 1.75; text-wrap: pretty; }
  .image-credits { margin-top: 1rem; color: hsl(var(--muted-foreground)); font-size: 0.7rem; line-height: 1.6; }
  .image-credits a { text-decoration: underline; text-underline-offset: 0.2em; }
  .image-credits a:hover { color: hsl(var(--primary)); }
  :global(.dark) .campus-image { opacity: 0.34; }
  :global(.dark) .campus-image :global(img) { filter: saturate(0.65) brightness(0.8); }
  .entry-heading { display: flex; justify-content: space-between; flex-wrap: wrap; align-items: baseline; gap: 0.5rem 1.25rem; }
  article h2 { font-size: 1.15rem; font-weight: 600; line-height: 1.6; overflow-wrap: anywhere; }
  .entry-date { color: hsl(var(--muted-foreground)); font-size: 0.8rem; }
  .entry-subtitle { margin-top: 0.5rem; font-size: 0.95rem; color: hsl(var(--primary)); }
  .entry-description { margin-top: 1rem; font-size: 0.95rem; line-height: 1.9; color: hsl(var(--muted-foreground)); white-space: pre-line; }
  .detail-title { margin-top: 1.75rem; font-size: 1rem; font-weight: 600; }
  .detail-title + .entry-description { margin-top: 0.6rem; }
  .project-highlights { display: grid; gap: 1.5rem; padding-left: 1.3rem; margin-top: 1rem; list-style: decimal; font-size: 0.95rem; line-height: 1.9; }
  .project-highlights li::marker { color: hsl(var(--primary)); }
  .project-highlights strong { font-weight: 600; }
  .project-highlights p { margin-top: 0.4rem; color: hsl(var(--muted-foreground)); overflow-wrap: anywhere; }
  .timeline-entry { position: relative; padding-left: 1.5rem; padding-bottom: 0.5rem; border-left: 1px solid hsl(var(--border)); }
  .timeline-entry::before { content: ''; position: absolute; top: 0.55rem; left: -0.25rem; width: 0.45rem; height: 0.45rem; border-radius: 50%; background: hsl(var(--primary)); box-shadow: 0 0 0 4px hsl(var(--background)); }
  .project-entry, .publication-entry { padding: 1.5rem; border: 1px solid hsl(var(--border)); border-radius: 1rem; }
  .project-entry { background: linear-gradient(120deg, hsl(var(--background)) 65%, hsl(var(--primary) / 0.04)); }
  .paper-authors { margin-top: 0.6rem; font-size: 0.95rem; }
  .paper-venue { margin-top: 0.4rem; font-size: 0.9rem; font-style: italic; color: hsl(var(--muted-foreground)); }
  .resource-links { display: flex; flex-wrap: wrap; gap: 0.75rem 1.25rem; margin-top: 1rem; font-size: 0.9rem; }
  .resource-links a { color: hsl(var(--primary)); text-decoration: underline; text-underline-offset: 0.25rem; }
  .page-toc { position: sticky; top: 7rem; padding-top: 0.65rem; }
  .page-toc h2 { margin-bottom: 1.25rem; font-size: 0.9rem; font-weight: 500; }
  .page-toc nav { display: grid; gap: 0.25rem; border-left: 1px solid hsl(var(--primary) / 0.5); }
  .page-toc a { margin-left: 0.5rem; padding: 0.6rem 0.8rem; border-radius: 0.75rem; color: hsl(var(--primary)); background: hsl(var(--muted) / 0.65); font-size: 0.9rem; line-height: 1.6; overflow-wrap: anywhere; }
  a:focus-visible { outline: 2px solid hsl(var(--primary)); outline-offset: 4px; }
  .empty-state { color: hsl(var(--muted-foreground)); }
  @media (max-width: 800px) { .page-grid { grid-template-columns: minmax(0, 1fr); } .page-toc { display: none; } }
  @media (max-width: 640px) {
    main { padding-block: 1rem 3rem; }
    .page-heading { margin-bottom: 2.25rem; }
    .project-entry, .publication-entry { padding: 1.25rem; }
    .education-entry { min-height: 12rem; padding: 1.35rem; }
    .education-copy { width: 85%; }
    .campus-image { left: 18%; opacity: 0.55; }
  }
</style>
