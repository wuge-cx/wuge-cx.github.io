---
import { Image } from 'astro:assets'
import ProfileLayout from '@/layouts/ProfileLayout.astro'
import ProfileHero from './ProfileHero.astro'
import blocks from '../../content/blog/3d-rendering/thumbnail.jpg'
import columns from '../../content/blog/improve-concentration/thumbnail.jpg'
import waves from '../../content/blog/music-journey/thumbnail.jpg'
import { pagePath, profile, sections, text, type Locale, type SectionId } from '../../data/profile'

interface Props { locale: Locale }
const { locale } = Astro.props
const researchAreas = ['LLM Post-training', 'Terminal Agents', 'SFT / GRPO']
const cardArt = {
  about: { image: blocks, position: '70% 50%', tone: 'rose' },
  education: { image: columns, position: '65% 65%', tone: 'lavender' },
  projects: { image: waves, position: '60% 65%', tone: 'blue' },
  internships: { image: blocks, position: '25% 75%', tone: 'sage' },
  publications: { image: columns, position: '50% 75%', tone: 'lavender' }
} satisfies Record<SectionId, { image: typeof blocks; position: string; tone: string }>
---

<ProfileLayout {locale}>
  <main id='main-content'>
    <section class='home-intro' aria-label={locale === 'zh' ? '个人简介' : 'Profile overview'}>
      <ProfileHero {locale} />
      <div class='research-intro'>
        <p class='eyebrow'>{locale === 'zh' ? '研究与实践' : 'RESEARCH & PRACTICE'}</p>
        <h2>{locale === 'zh' ? '从任务构建，到 Agent 训练。' : 'From task design to agent training.'}</h2>
        <p class='introduction'>{text(profile.summary, locale)}</p>
        <ul class='research-tags' aria-label={locale === 'zh' ? '研究方向' : 'Research interests'}>
          {researchAreas.map((area) => <li>{area}</li>)}
        </ul>
      </div>
    </section>
    <nav class='page-cards' aria-label={locale === 'zh' ? '浏览个人资料' : 'Explore my profile'}>
      {sections.map((section, index) => <a class='page-card' data-tone={cardArt[section.id].tone}
        href={pagePath(locale, section.id)} style={{ '--art-position': cardArt[section.id].position }}>
        <div class='card-art' aria-hidden='true'>
          <Image src={cardArt[section.id].image} alt='' width={960} height={540} format='webp' loading='eager' />
        </div>
        <div class='card-copy'>
          <span class='card-index' aria-hidden='true'>{String(index + 1).padStart(2, '0')}</span>
          <h2>{text(section.label, locale)}</h2>
          <p>{text(section.summary, locale)}</p>
        </div>
        <span class='card-arrow' aria-hidden='true'>↗</span>
      </a>)}
    </nav>
  </main>
</ProfileLayout>

<style>
  main { padding-block: 3.75rem 4.5rem; }
  .home-intro { display: grid; grid-template-columns: minmax(15rem, 0.9fr) minmax(0, 1.1fr); gap: 4rem; align-items: center; margin-bottom: 3rem; }
  .research-intro { padding: 1.8rem; border: 1px solid hsl(var(--border) / 0.7); border-radius: 1.15rem; background: linear-gradient(135deg, hsl(var(--primary) / 0.045), hsl(var(--background)) 65%); }
  .eyebrow { font-size: 0.7rem; letter-spacing: 0.1em; color: hsl(var(--primary)); margin-bottom: 0.9rem; }
  .research-intro h2 { font-size: 1.15rem; line-height: 1.65; font-weight: 500; text-wrap: balance; }
  .introduction { margin-top: 0.75rem; color: hsl(var(--muted-foreground)); font-size: 0.9rem; line-height: 1.95; text-wrap: pretty; }
  .research-tags { display: flex; flex-wrap: wrap; gap: 0.45rem; margin-top: 1.1rem; }
  .research-tags li { padding: 0.3rem 0.55rem; border: 1px solid hsl(var(--border)); border-radius: 0.4rem; font-size: 0.68rem; color: hsl(var(--muted-foreground)); }
  .page-cards { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.25rem; }
  .page-card {
    --card-tint: 208 32% 92%;
    --art-opacity: 0.62;
    position: relative; isolation: isolate; display: flex; align-items: center;
    min-height: 11rem; padding: 1.6rem 1.75rem; overflow: hidden;
    border: 1px solid hsl(var(--border)); border-radius: 1.15rem;
    background: linear-gradient(110deg, hsl(var(--background)) 24%, hsl(var(--card-tint) / 0.55));
    box-shadow: 0 2px 5px hsl(var(--foreground) / 0.02);
    transition: transform 220ms ease, border-color 220ms ease, box-shadow 220ms ease;
  }
  .page-card[data-tone='rose'] { --card-tint: 350 28% 92%; }
  .page-card[data-tone='lavender'] { --card-tint: 245 28% 93%; }
  .page-card[data-tone='sage'] { --card-tint: 168 20% 91%; }
  .page-card:last-child { grid-column: 1 / -1; min-height: 10rem; }
  .card-art {
    position: absolute; inset: 0; z-index: -1; pointer-events: none; opacity: var(--art-opacity);
    -webkit-mask-image: linear-gradient(90deg, transparent 18%, rgb(0 0 0 / 0.04) 35%, rgb(0 0 0 / 0.55) 65%, #000 100%);
    mask-image: linear-gradient(90deg, transparent 18%, rgb(0 0 0 / 0.04) 35%, rgb(0 0 0 / 0.55) 65%, #000 100%);
    transition: opacity 250ms ease;
  }
  .card-art :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: var(--art-position); filter: saturate(0.65); transition: transform 450ms ease; }
  .page-card:last-child .card-art { left: 22%; }
  .card-copy { max-width: min(78%, 25rem); }
  .card-index { display: block; margin-bottom: 0.65rem; color: hsl(var(--primary)); font-family: ui-monospace, monospace; font-size: 0.7rem; letter-spacing: 0.12em; }
  .page-card h2 { font-size: 1.15rem; font-weight: 600; line-height: 1.5; }
  .page-card p { margin-top: 0.5rem; color: hsl(var(--muted-foreground)); font-size: 0.9rem; line-height: 1.75; text-wrap: pretty; }
  .card-arrow { position: absolute; top: 1.35rem; right: 1.35rem; display: grid; place-items: center; width: 2rem; height: 2rem; border: 1px solid hsl(var(--border) / 0.8); border-radius: 50%; background: hsl(var(--background) / 0.78); color: hsl(var(--primary)); font-size: 1.2rem; transition: transform 220ms ease, background-color 220ms ease; }
  .page-card:focus-visible { outline: 2px solid hsl(var(--primary)); outline-offset: 4px; }
  .page-card:focus-visible .card-arrow { background: hsl(var(--background)); transform: translate(2px, -2px); }
  @media (hover: hover) {
    .page-card:hover { transform: translateY(-3px); border-color: hsl(var(--primary) / 0.35); box-shadow: 0 10px 24px hsl(var(--foreground) / 0.055); }
    .page-card:hover .card-art { opacity: calc(var(--art-opacity) + 0.08); }
    .page-card:hover .card-art :global(img) { transform: scale(1.035); }
    .page-card:hover .card-arrow { transform: translate(2px, -2px); background: hsl(var(--background)); }
  }
  :global(.dark) .page-card { --art-opacity: 0.3; background: linear-gradient(110deg, hsl(var(--background)) 24%, hsl(var(--card-tint) / 0.07)); }
  :global(.dark) .card-art :global(img) { filter: saturate(0.65) brightness(0.8); }
  @media (max-width: 800px) { .home-intro { grid-template-columns: 1fr; gap: 1.5rem; margin-bottom: 2.25rem; } }
  @media (max-width: 640px) {
    main { padding-block: 2rem 3rem; }
    .page-cards { grid-template-columns: 1fr; gap: 1rem; }
    .page-card, .page-card:last-child { min-height: 10rem; padding: 1.35rem; }
    .page-card:last-child .card-art { left: 0; }
    .card-copy { max-width: 78%; }
    .card-arrow { top: 1.2rem; right: 1.2rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .page-card, .card-art, .card-art :global(img), .card-arrow { transition: none; }
    .page-card:hover, .page-card:hover .card-art :global(img), .page-card:hover .card-arrow, .page-card:focus-visible .card-arrow { transform: none; }
  }
</style>
