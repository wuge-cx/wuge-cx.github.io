---
import { Font } from 'astro:assets'

import type { SiteMeta } from 'astro-pure/types'
import config from 'virtual:config'

type Props = SiteMeta & {
  siteName?: string
  authorName?: string
  localeCode?: string
  noindex?: boolean
}

const {
  articleDate, description, ogImage, title,
  siteName = config.title, authorName = config.author, localeCode = config.locale.attrs, noindex = false
} = Astro.props

const siteTitle = title === siteName ? siteName : `${title} ${config.titleDelimiter} ${siteName}`
const canonicalURL = new URL(Astro.url.pathname, Astro.site)
const socialImageURL = new URL(ogImage ? ogImage : config.socialCard, Astro.site).href
---

<meta charset='utf-8' />
<meta
  content='width=device-width, initial-scale=1.0, shrink-to-fit=no, viewport-fit=cover'
  name='viewport'
/>
<meta content='IE=edge' http-equiv='X-UA-Compatible' />
<title>{siteTitle}</title>

{/* Icons / Favicon */}
<link rel='icon' type={config.favicon.type} href={config.favicon.href} />
<link rel='shortcut icon' type={config.favicon.type} href={config.favicon.href} />
<link rel='icon' type='image/png' sizes='32x32' href='/favicon/favicon-32x32.png' />
<link rel='icon' type='image/png' sizes='16x16' href='/favicon/favicon-16x16.png' />
<link rel='apple-touch-icon' sizes='180x180' href='/favicon/apple-touch-icon.png' />
<link rel='manifest' href='/favicon/site.webmanifest' />

{/* Font preloads */}
<Font cssVariable='--font-satoshi' preload={[{ subset: 'latin', style: 'normal' }]} />
<style>
  body {
    font-family: var(--font-satoshi);
  }
</style>

{/* Canonical URL */}
<link rel='canonical' href={canonicalURL} />

{/* Primary Meta Tags */}
<meta content={siteTitle} name='title' />
<meta content={description} name='description' />
<meta content={authorName} name='author' />
{noindex && <meta name='robots' content='noindex, follow' />}

{/* Theme Color */}
{/* <meta content='' name='theme-color' /> */}
<meta name='color-scheme' content='light dark' />

{/* Open Graph / Facebook */}
<meta content={articleDate ? 'article' : 'website'} property='og:type' />
<meta content={title} property='og:title' />
<meta content={description} property='og:description' />
<meta content={canonicalURL} property='og:url' />
<meta content={siteName} property='og:site_name' />
<meta content={localeCode} property='og:locale' />
<meta content={socialImageURL} property='og:image' />
<meta content='Xi Chen — LLM Post-training & Terminal Agents' property='og:image:alt' />
<meta content='1200' property='og:image:width' />
<meta content='630' property='og:image:height' />
{
  articleDate && (
    <>
      <meta content={authorName} property='article:author' />
      <meta content={articleDate} property='article:published_time' />
    </>
  )
}

{/* Twitter */}
<meta content='summary_large_image' property='twitter:card' />
<meta content={canonicalURL} property='twitter:url' />
<meta content={title} property='twitter:title' />
<meta content={description} property='twitter:description' />
<meta content={socialImageURL} property='twitter:image' />

{/* Sitemap */}
<link href='/sitemap-index.xml' rel='sitemap' />

<meta content={Astro.generator} name='generator' />
