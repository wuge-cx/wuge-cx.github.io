---
import { ThemeProvider } from 'astro-pure/components/basic'
import BaseHead from '@/components/BaseHead.astro'
import ProfileHeader from '@/components/profile/ProfileHeader.astro'
import { pagePath, projectPath, profile, sections, text, type Locale, type SectionId } from '../data/profile'
import '@/assets/styles/global.css'
import '@/assets/styles/app.css'

interface Props { locale: Locale; section?: SectionId; pageTitle?: string; pageDescription?: string; projectSlug?: string; noindex?: boolean }
const { locale, section, pageTitle, pageDescription, projectSlug, noindex = false } = Astro.props
const language = locale === 'zh' ? 'zh-CN' : 'en'
const currentSection = sections.find((item) => item.id === section)
const title = pageTitle ?? (currentSection ? text(currentSection.label, locale) : text(profile.name, locale))
const description = pageDescription ?? (currentSection ? text(currentSection.summary, locale) : text(profile.description, locale))
const localizedPath = (lang: Locale) => projectSlug ? projectPath(lang, projectSlug) : pagePath(lang, section)
---

<html lang={language}>
  <head>
    <BaseHead {title} {description}
      siteName={text(profile.siteTitle, locale)} authorName={text(profile.name, locale)}
      localeCode={locale === 'zh' ? 'zh_CN' : 'en_US'} {noindex} />
    {!noindex && <>
      <link rel='alternate' hreflang='zh-CN' href={new URL(localizedPath('zh'), Astro.site)} />
      <link rel='alternate' hreflang='en' href={new URL(localizedPath('en'), Astro.site)} />
      <link rel='alternate' hreflang='x-default' href={new URL(localizedPath('zh'), Astro.site)} />
    </>}
    <script is:inline>
      try { if (!localStorage.getItem('theme')) localStorage.setItem('theme', 'light') } catch {}
    </script>
    <ThemeProvider />
  </head>
  <body id='top' class='bg-background text-foreground'>
    <a class='skip-link' href='#main-content'>{locale === 'zh' ? '跳转到正文' : 'Skip to content'}</a>
    <div class='profile-shell'>
      <ProfileHeader {locale} activeSection={section} alternatePath={localizedPath(locale === 'zh' ? 'en' : 'zh')} />
      <slot />
      <footer class='profile-footer'>
        <span>© {new Date().getFullYear()} {text(profile.name, locale)}</span>
        <div class='footer-links'>
          <a href={profile.github} target='_blank' rel='noopener noreferrer'>GitHub ↗</a>
          <a href={profile.contacts[0].href}>{locale === 'zh' ? '邮件联系' : 'Email'}</a>
          <a href='#top'>{locale === 'zh' ? '回到顶部 ↑' : 'Back to top ↑'}</a>
        </div>
      </footer>
    </div>
  </body>
</html>

<style>
  :global(html) { scroll-behavior: smooth; }
  :global(body) { margin: 0; font-family: var(--font-satoshi), 'Segoe UI', 'PingFang SC', 'Microsoft YaHei', sans-serif; }
  .profile-shell { display: flex; flex-direction: column; max-width: 70rem; min-height: 100dvh; margin-inline: auto; padding-inline: 2.5rem; }
  .profile-footer { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 1rem; margin-top: auto; padding: 1.5rem 0 2rem; border-top: 1px solid hsl(var(--border)); color: hsl(var(--muted-foreground)); font-size: 0.85rem; }
  .footer-links { display: flex; flex-wrap: wrap; gap: 1.25rem; }
  .footer-links a:hover { color: hsl(var(--primary)); }
  :global(a:focus-visible), :global(button:focus-visible) { outline: 2px solid hsl(var(--primary)); outline-offset: 4px; }
  .skip-link { position: absolute; left: 1rem; top: -5rem; z-index: 100; padding: 0.75rem 1rem; border: 1px solid hsl(var(--border)); border-radius: 0.5rem; background: hsl(var(--background)); }
  .skip-link:focus { top: 0.5rem; }
  @media (max-width: 640px) {
    .profile-shell { padding-inline: 1.25rem; }
  }
  @media (prefers-reduced-motion: reduce) { :global(html) { scroll-behavior: auto; } }
</style>
